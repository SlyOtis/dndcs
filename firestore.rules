rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(ownerId) {
      return signedIn() && uid() == ownerId;
    }

    function campaignOf(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);

      match /data/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /files/{document=**} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }

    match /characters/{characterId} {
      function stored() {
        return resource.data;
      }

      function inCampaign() {
        return stored().campaign_id != null
          && signedIn()
          && campaignOf(stored().campaign_id).dm_id == uid();
      }

      allow read: if isOwner(stored().owner_id)
        || stored().metadata.is_public == true
        || (signedIn() && uid() in stored().permissions.viewers)
        || (signedIn() && uid() in stored().permissions.editors)
        || inCampaign();

      allow create: if isOwner(request.resource.data.owner_id);

      allow update: if isOwner(stored().owner_id)
        || (signedIn() && uid() in stored().permissions.editors)
        || inCampaign();

      allow delete: if isOwner(stored().owner_id);

      match /{document=**} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/characters/$(characterId)).data.owner_id);
      }
    }

    match /campaigns/{campaignId} {
      function stored() {
        return resource.data;
      }

      function isMember() {
        return isOwner(stored().dm_id) || (signedIn() && uid() in stored().player_ids);
      }

      allow read: if isMember();
      allow create: if isOwner(request.resource.data.dm_id);
      allow update: if isOwner(stored().dm_id);
      allow delete: if isOwner(stored().dm_id);

      match /files/{fileId}/{document=**} {
        function parent() {
          return campaignOf(campaignId);
        }

        allow read: if isOwner(parent().dm_id) || (signedIn() && uid() in parent().player_ids);
        allow write: if isOwner(parent().dm_id);
      }

      match /peers/{peerId} {
        function member() {
          return isOwner(campaignOf(campaignId).dm_id)
            || (signedIn() && uid() in campaignOf(campaignId).player_ids);
        }

        allow read: if member();
        allow write: if member() && peerId.split('\\.')[0] == uid();
      }

      match /signals/{signalId} {
        function member() {
          return isOwner(campaignOf(campaignId).dm_id)
            || (signedIn() && uid() in campaignOf(campaignId).player_ids);
        }

        allow read, delete: if member();
        allow create: if member() && request.resource.data.from.split('\\.')[0] == uid();
      }

      match /chat/{entryId} {
        function member() {
          return isOwner(campaignOf(campaignId).dm_id)
            || (signedIn() && uid() in campaignOf(campaignId).player_ids);
        }

        allow read: if member();
        allow create: if member() && request.resource.data.author_id == uid();
        allow update, delete: if isOwner(resource.data.author_id);
      }

      match /{part}/{recordId} {
        function parent() {
          return campaignOf(campaignId);
        }

        function readsParent() {
          return isOwner(parent().dm_id) || (signedIn() && uid() in parent().player_ids);
        }

        allow read: if readsParent();
        allow write: if isOwner(parent().dm_id) && part != 'chat';
      }
    }

    match /catalog/{kind}/entries/{entryId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.owner_id);
      allow update, delete: if isOwner(resource.data.owner_id);
    }

    match /chatSessions/{sessionId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
