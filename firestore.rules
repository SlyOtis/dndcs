rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(ownerId) {
      return signedIn() && uid() == ownerId;
    }

    function campaignOf(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
    }

    // A member who is not the owner may touch the roll of characters and nothing else.
    function onlyCharacters() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['character_ids', 'updated_at']);
    }

    // The stored collection names, not the display kinds: characters live in
    // npcs and places live in locations, which is what the path actually carries.
    function resourceKinds() {
      return [
        'entries', 'npcs', 'heroes', 'items', 'weapons',
        'armor', 'locations', 'maps', 'sessions', 'quests'
      ];
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);

      match /data/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /files/{document=**} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }

      match /{kind}/{resourceId} {
        allow read: if kind in resourceKinds() && signedIn() && uid() in resource.data.readers;
        allow create: if kind in resourceKinds() && isOwner(userId)
          && isOwner(request.resource.data.owner_id);
        allow update, delete: if kind in resourceKinds() && isOwner(resource.data.owner_id);

        match /updates/{updateId} {
          function held() {
            return get(/databases/$(database)/documents/users/$(userId)/$(kind)/$(resourceId)).data;
          }

          allow read: if signedIn() && uid() in held().readers;
          allow create: if signedIn() && uid() in held().readers
            && isOwner(request.resource.data.by);
          allow delete: if signedIn() && uid() in held().readers;
        }
      }
    }

    match /parties/{partyId} {
      allow read: if signedIn() && uid() in resource.data.member_ids;
      allow create: if isOwner(request.resource.data.owner_id);
      allow update: if isOwner(resource.data.owner_id)
        || (signedIn() && uid() in resource.data.member_ids && onlyCharacters());
      allow delete: if isOwner(resource.data.owner_id);
    }

    match /characters/{characterId} {
      function stored() {
        return resource.data;
      }

      function inCampaign() {
        return stored().campaign_id != null
          && signedIn()
          && campaignOf(stored().campaign_id).dm_id == uid();
      }

      function atTheTable() {
        return stored().campaign_id != null
          && signedIn()
          && uid() in campaignOf(stored().campaign_id).player_ids;
      }

      allow read: if isOwner(stored().owner_id)
        || stored().metadata.is_public == true
        || (signedIn() && uid() in stored().permissions.viewers)
        || (signedIn() && uid() in stored().permissions.editors)
        || inCampaign()
        || atTheTable();

      allow create: if isOwner(request.resource.data.owner_id);

      allow update: if isOwner(stored().owner_id)
        || (signedIn() && uid() in stored().permissions.editors)
        || inCampaign();

      allow delete: if isOwner(stored().owner_id);

      match /{document=**} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/characters/$(characterId)).data.owner_id);
      }
    }

    match /campaigns/{campaignId} {
      function stored() {
        return resource.data;
      }

      function isMember() {
        return isOwner(stored().dm_id) || (signedIn() && uid() in stored().player_ids);
      }

      allow read: if isMember();
      allow create: if isOwner(request.resource.data.dm_id);
      allow update: if isOwner(stored().dm_id)
        || (signedIn() && uid() in stored().player_ids && onlyCharacters());
      allow delete: if isOwner(stored().dm_id);

      match /files/{fileId}/{document=**} {
        function parent() {
          return campaignOf(campaignId);
        }

        allow read: if isOwner(parent().dm_id) || (signedIn() && uid() in parent().player_ids);
        allow write: if isOwner(parent().dm_id);
        allow create: if signedIn() && uid() in parent().player_ids
          && isOwner(request.resource.data.owner_id);
      }

      match /peers/{peerId} {
        function member() {
          return isOwner(campaignOf(campaignId).dm_id)
            || (signedIn() && uid() in campaignOf(campaignId).player_ids);
        }

        allow read: if member();
        allow write: if member() && peerId.split('\\.')[0] == uid();
      }

      match /signals/{signalId} {
        function member() {
          return isOwner(campaignOf(campaignId).dm_id)
            || (signedIn() && uid() in campaignOf(campaignId).player_ids);
        }

        allow read, delete: if member();
        allow create: if member() && request.resource.data.from.split('\\.')[0] == uid();
      }

      match /chat/{entryId} {
        function member() {
          return isOwner(campaignOf(campaignId).dm_id)
            || (signedIn() && uid() in campaignOf(campaignId).player_ids);
        }

        allow read: if member() && (resource.data.is_hidden == false || isOwner(campaignOf(campaignId).dm_id));
        allow create: if member() && request.resource.data.author_id == uid();
        allow update, delete: if isOwner(resource.data.author_id);
      }

      // The table's own fixtures rather than anyone's resources: the charts the
      // canvas draws and the encounters it runs are read by every member.
      match /maps/{mapId} {
        allow read: if isOwner(campaignOf(campaignId).dm_id)
          || (signedIn() && uid() in campaignOf(campaignId).player_ids);
        allow write: if isOwner(campaignOf(campaignId).dm_id);
      }

      match /encounters/{encounterId} {
        allow read: if isOwner(campaignOf(campaignId).dm_id)
          || (signedIn() && uid() in campaignOf(campaignId).player_ids);
        allow write: if isOwner(campaignOf(campaignId).dm_id);
      }

      match /{part}/{recordId} {
        function parent() {
          return campaignOf(campaignId);
        }

        function atTheTable() {
          return isOwner(parent().dm_id) || (signedIn() && uid() in parent().player_ids);
        }

        allow read: if signedIn() && uid() in resource.data.readers;
        allow create: if part != 'chat' && atTheTable() && isOwner(request.resource.data.owner_id);
        allow update, delete: if part != 'chat' && isOwner(resource.data.owner_id);

        match /updates/{updateId} {
          function held() {
            return get(/databases/$(database)/documents/campaigns/$(campaignId)/$(part)/$(recordId)).data;
          }

          allow read: if signedIn() && uid() in held().readers;
          allow create: if signedIn() && uid() in held().readers
            && isOwner(request.resource.data.by);
          allow delete: if signedIn() && uid() in held().readers;
        }
      }
    }

    match /catalog/{kind}/entries/{entryId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.owner_id);
      allow update, delete: if isOwner(resource.data.owner_id);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
