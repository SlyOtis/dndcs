{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Character Level Progression Schema",
  "description": "Defines what choices and features are available at each level for a character class/subclass",
  "type": "object",
  "required": ["classId", "className", "hitDie", "levels"],
  "properties": {
    "classId": {
      "type": "string",
      "description": "Unique identifier for this class/subclass combination"
    },
    "className": {
      "type": "string",
      "description": "Display name of the class"
    },
    "subclassName": {
      "type": "string",
      "description": "Optional subclass name if this is a subclass progression"
    },
    "hitDie": {
      "type": "integer",
      "minimum": 4,
      "maximum": 12,
      "description": "Hit die size (d4, d6, d8, d10, d12)"
    },
    "primaryAbilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Strength", "Dexterity", "Constitution", "Intelligence", "Wisdom", "Charisma"]
      },
      "description": "Primary abilities for this class"
    },
    "savingThrowProficiencies": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Strength", "Dexterity", "Constitution", "Intelligence", "Wisdom", "Charisma"]
      },
      "maxItems": 2,
      "description": "Saving throw proficiencies gained at level 1"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/LevelProgression"
      },
      "description": "Level-by-level progression data"
    }
  },
  "definitions": {
    "LevelProgression": {
      "type": "object",
      "required": ["level", "proficiencyBonus"],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "proficiencyBonus": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "automaticFeatures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Feature IDs that are automatically granted at this level"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LevelChoice"
          },
          "description": "Choices the player must make at this level"
        },
        "abilityScoreImprovement": {
          "type": "boolean",
          "default": false,
          "description": "Whether this level grants an ASI/feat choice"
        },
        "spellSlots": {
          "type": "object",
          "patternProperties": {
            "^[1-9]$": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Spell slots available at this level (by spell level)"
        },
        "spellsKnown": {
          "type": "integer",
          "minimum": 0,
          "description": "Total spells known at this level"
        },
        "cantripsKnown": {
          "type": "integer",
          "minimum": 0,
          "description": "Total cantrips known at this level"
        }
      }
    },
    "LevelChoice": {
      "type": "object",
      "required": ["id", "name", "type", "count"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this choice"
        },
        "name": {
          "type": "string",
          "description": "Display name for this choice"
        },
        "description": {
          "type": "string",
          "description": "Description of what this choice represents"
        },
        "type": {
          "type": "string",
          "enum": [
            "feature",
            "subclass", 
            "skill",
            "spell",
            "cantrip",
            "fighting_style",
            "expertise",
            "metamagic",
            "invocation",
            "maneuver",
            "custom"
          ],
          "description": "Type of choice being made"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of selections to make"
        },
        "from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of feature IDs or categories to choose from"
        },
        "constraints": {
          "type": "object",
          "properties": {
            "prerequisite": {
              "type": "string",
              "description": "Prerequisite feature ID or condition"
            },
            "excludes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Feature IDs that cannot be selected with this choice"
            },
            "spellLevel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9,
              "description": "For spell choices, the maximum spell level"
            },
            "school": {
              "type": "string",
              "description": "For spell choices, required school of magic"
            }
          }
        }
      }
    }
  }
}